# 环境开关写在 .env（APP_ENV=test 或 prod）；本文件复制为 .env.local 后填写（.env.local 不会提交到 git）
# 位置：Supabase 控制台 → Project Settings → API Keys
# publishable key（sb_publishable_…）或旧版 anon key；可以公开，数据安全由 RLS 保证
SUPABASE_URL_TEST=https://你的测试项目.supabase.co
SUPABASE_KEY_TEST=
SUPABASE_URL_PROD=https://你的生产项目.supabase.co
SUPABASE_KEY_PROD=

# 地图：天地图 key（可以公开，但请限制成你的网站域名）。不填时国内也用 Esri 底图
# https://console.tianditu.gov.cn → 应用管理 → 创建「浏览器端」应用，白名单填网站域名（本地开发加 localhost）
VITE_TIANDITU_KEY=
