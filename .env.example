# 复制为 .env.local 后填写（.env.local 不会提交到 git）
# 位置：Supabase 控制台 → Project Settings → API
VITE_SUPABASE_URL=https://你的项目.supabase.co
# publishable key（sb_publishable_…）或旧版 anon key；可以公开，数据安全由 RLS 保证
VITE_SUPABASE_KEY=

# 地图：天地图 key（可以公开，但请限制成你的网站域名）。不填时国内也用 Esri 底图
# https://console.tianditu.gov.cn → 应用管理 → 创建「浏览器端」应用，白名单填网站域名（本地开发加 localhost）
VITE_TIANDITU_KEY=
