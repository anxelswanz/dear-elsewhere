// Cloudflare 部署配置：发布 npm run build 生成的静态文件（dist/），外加 worker/index.js
// worker 只处理 /sb/*（转发到 Supabase）和 /geo/*（转发到 Esri 地名搜索）：国内直连这两家都很慢；其余请求直接走静态文件
// 有了这个文件，wrangler 就不会去自动识别项目、解析 vite.config.js
// public/_headers（CSP、缓存）会被一起发布并对静态文件生效
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dear-elsewhere", // 必须和 Cloudflare 控制台里这个 Worker 的名字一致
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/sb/*", "/geo/*"]
  },
  "vars": {
    // 生产库地址（不是密钥，前端打包产物里本来就有）
    "SUPABASE_UPSTREAM": "https://dvrqcbjwzeqpjsxrfddr.supabase.co"
  }
}
