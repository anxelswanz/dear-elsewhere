# Cloudflare Pages 的响应头（部署到其他平台时，把同样的头配到对应的配置里）
#
# CSP 允许的外部来源，新增服务时要同步加上：
#   *.supabase.co             数据库、登录、实时推送（wss）、照片签名链接
#   server.arcgisonline.com   Esri 底图瓦片
#   geocode.arcgis.com        Esri 地名反查、地点搜索
#   *.tianditu.gov.cn         天地图瓦片和接口（配了 VITE_TIANDITU_KEY 才会用到）
#   tiles.openfreemap.org     截图里的街道数据（src/streets.js）
# 样式需要 'unsafe-inline'：页面里有 style="--i: …" 这类内联样式；脚本不允许内联（主题、语言脚本放在 public/boot/）

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://server.arcgisonline.com https://*.tianditu.gov.cn; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://geocode.arcgis.com https://api.tianditu.gov.cn https://tiles.openfreemap.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# 打包产物文件名带哈希，可以永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 行政区边界数据（文件名不带哈希，重新生成后最多一天生效）
/data/*
  Cache-Control: public, max-age=86400

/avatars/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
